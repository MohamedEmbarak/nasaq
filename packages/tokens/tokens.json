        "$type": "string",
        "$value": "0px 1px 2px 0px rgb(16 24 40 / 0.05), 0px 1px 3px 0px rgb(16 24 40 / 0.05)",
        "$extensions": {
          "org.nasaq.dga": {
            "node": "7:12421",
            "name": "Shadows/shadow-sm"
          }
        }
      },
      "md": {
        "$type": "string",
        "$value": "0px 2px 4px -2px rgb(16 24 40 / 0.06), 0px 4px 8px -2px rgb(16 24 40 / 0.10)",
        "$extensions": {
          "org.nasaq.dga": {
            "node": "7:12422",
            "name": "Shadows/shadow-md"
