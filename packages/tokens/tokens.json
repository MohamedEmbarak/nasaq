{
  "$description": "Nasaq semantic tokens mapped to the user-supplied DGA Platforms Code Foundations snapshot exported 2026-10-29. DGA is the default; nasaq preserves the original Woven Rhythm palette. Mapping is not certification. See reference/dga-foundations.json.",
  "$extensions": {
    "org.nasaq": {
      "version": "0.1.0",
      "status": "public source preview",
      "referenceTheme": "dga is approximate; no affiliation or certification",
      "defaultTheme": "dga"
    }
  },
  "foundation": {
    "font": {
      "sans": {
        "$type": "fontFamily",
        "$value": "\"IBM Plex Sans Arabic\", \"IBM Plex Sans\", \"Noto Sans Arabic\", \"Segoe UI\", Tahoma, Arial, sans-serif"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "\"IBM Plex Mono\", \"SFMono-Regular\", Consolas, monospace"
      }
    },
    "text": {
      "xs": {
        "$type": "dimension",
        "$value": "0.75rem"
      },
      "sm": {
        "$type": "dimension",
        "$value": "0.875rem"
      },
      "md": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "lg": {
        "$type": "dimension",
        "$value": "1.125rem"
      },
      "xl": {
        "$type": "dimension",
        "$value": "1.25rem"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "1.5rem"
