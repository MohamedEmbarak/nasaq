{
  "name": "nasaq-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/prepare-demo.mjs && vite --host 0.0.0.0 --config apps/playground/vite.config.ts",
    "build": "node scripts/build.mjs",
    "build:packages": "node scripts/build.mjs --packages",
    "typecheck:playground": "tsc -p apps/playground/tsconfig.json --noEmit",
    "test": "node --test packages/tokens/test/contrast.test.mjs && vitest run",
    "test:browser": "playwright test",
    "check": "pnpm build && pnpm test && pnpm test:browser",
    "check:packages": "node scripts/check-packages.mjs",
    "new:component": "node scripts/new-component.mjs",
    "build:docs": "node scripts/build.mjs --docs",
    "preview:docs": "vite preview --host 0.0.0.0 --config apps/playground/vite.config.ts"
  },
  "devDependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@axe-core/playwright": "^4.10.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.5",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-vue": "6.0.10",
    "codemirror": "^6.0.2",
    "jsdom": "^27.0.0",
    "ng-packagr": "22.2.5",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue": "3.5.44"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohamedEmbarak/nasaq.git"
  },
  "homepage": "https://mohamedembarak.github.io/nasaq/",
  "bugs": {
    "url": "https://github.com/MohamedEmbarak/nasaq/issues"
  },
  "author": {
    "name": "Development Team, National Platforms Sector — National Information Center"
  },
  "contributors": [
    {
      "name": "Mohamed Embarak",
      "url": "https://github.com/MohamedEmbarak"
    }
  ]
}
